# Copiá este archivo como .env.local para programar en tu compu SIN tocar producción.
# "npm run db:local" y "npm run dev:local" usan estas variables (pisan a las del .env).
# .env.local NO se sube a git.

# Base local (la levanta "npm run db:local"). Tiene que ser localhost: si no, los scripts no arrancan.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/corta_la_bocha

NODE_ENV=development
PORT=3000
JWT_SECRET=secreto-solo-para-programar
JWT_EXPIRATION=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# IA de prueba (valida con un banco fijo, no gasta cuota). Para probar con la IA real:
# AI_PROVIDER=gemini y GEMINI_API_KEY=tu-clave
AI_PROVIDER=fake

# Login con Google (opcional, mismo valor que VITE_GOOGLE_CLIENT_ID del frontend)
GOOGLE_CLIENT_ID=

# Mails: sin configurar, el link de "recuperar contraseña" aparece en la consola
MAIL_PROVIDER=
