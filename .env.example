DATABASE_URL=postgresql://postgres:postgres@postgres:5432/corta_la_bocha

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=corta_la_bocha
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Validación de respuestas con IA
# AI_PROVIDER: gemini (por defecto), anthropic u openai. Sólo hace falta la clave del proveedor elegido.
# Si falta la clave, el juego funciona pero las respuestas quedan "sin validar" (0 puntos).
AI_PROVIDER=gemini
# AI_MODEL (opcional): cambia el modelo. Por defecto: gemini-3.8-flash / claude-haiku-5-5 / gpt-4o-mini
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# JWT Configuration (JWT_SECRET es obligatorio con NODE_ENV=production)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=7d

# Login con Google (opcional). Si no está definido, el botón de Google no funciona y nada más se rompe.
# Es el mismo Client ID que VITE_GOOGLE_CLIENT_ID del frontend.
GOOGLE_CLIENT_ID=

# Emails (recuperar contraseña). Opcional: sin configurar, no se mandan mails y se avisa en el log
# (fuera de producción el link aparece en la consola para poder probar).
# MAIL_PROVIDER=resend → RESEND_API_KEY | MAIL_PROVIDER=smtp → SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE
MAIL_PROVIDER=
MAIL_FROM="Corta La Bocha <no-responder@tudominio.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# URL del frontend (para armar el link del mail)
FRONTEND_URL=http://localhost:5173

# Server Configuration
NODE_ENV=development
PORT=3000
# Opcional: orígenes permitidos por CORS, separados por coma. Vacío = cualquiera
CORS_ORIGIN=http://localhost:5173

