generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS
// ============================================

model users {
  id            String    @id @default(uuid()) @db.Uuid
  username      String    @unique @db.VarChar(30)
  first_name    String?   @db.VarChar(50)
  last_name     String?   @db.VarChar(50)
  birth_date    DateTime? @db.Date
  country       String?   @db.VarChar(56)
  email         String?   @unique @db.VarChar(255)
  password_hash String?
  // Id de la cuenta de Google (campo "sub" del ID token) si entró con Google
  google_id     String?   @unique @db.VarChar(255)
  is_guest      Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamp(6)

  profile      profiles?
  room_players room_players[]
  votes        votes[]
  solo_matches matches[]
  achievements user_achievements[]
  results      match_results[]
  game_stats   game_stats[]
  daily        daily_challenges[]
  password_resets password_resets[]
}

model profiles {
  id               String  @id @default(uuid()) @db.Uuid
  user_id          String  @unique @db.Uuid
  favorite_team    String? @db.VarChar(100)
  favorite_country String? @db.VarChar(100)
  favorite_player  String? @db.VarChar(100)

  // Perfil público / personalización
  avatar_url String? // en desuso: el avatar ahora se elige de un set propio (avatar_id)
  avatar_id  String? @db.VarChar(30)
  bio        String? @db.VarChar(160)

  matches_played  Int @default(0)
  matches_won     Int @default(0)
  tournaments_won Int @default(0)
  total_points    Int @default(0)
  best_streak     Int @default(0)
  current_streak  Int @default(0)

  // ELO (arranca en 1000). elo_games = partidas que lo movieron (para mostrar "sin ranking" si es 0)
  elo       Int @default(1000)
  elo_games Int @default(0)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Resultado de cada jugador en cada partida que contó para estadísticas. Con esto se arman las
// tablas semanal y mensual (sumando las partidas del período) y el historial de ELO.
model match_results {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  match_id   String   @db.Uuid
  game       String   @default("tutti_frutti") @db.VarChar(30)
  mode       String   @db.VarChar(20)
  points     Int      @default(0)
  won        Boolean  @default(false)
  abandoned  Boolean  @default(false)
  elo_before Int
  elo_after  Int
  created_at DateTime @default(now()) @db.Timestamp(6)

  user  users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  match matches @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@unique([match_id, user_id])
  @@index([created_at])
  @@index([user_id, created_at])
}

// Logros desbloqueados. Las definiciones (nombre, descripción, condición) están en
// src/achievements/achievements.definitions.ts; acá sólo se guarda cuál y cuándo.
model user_achievements {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  achievement_id String   @db.VarChar(40)
  unlocked_at    DateTime @default(now()) @db.Timestamp(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_id])
}

// ============================================
// ROOMS
// ============================================

model rooms {
  id          String   @id @default(uuid()) @db.Uuid
  room_code   String?  @unique @db.VarChar(10)
  is_private  Boolean  @default(false)
  status      String   @default("waiting") @db.VarChar(20)
  // De qué juego es la sala (tutti_frutti, ahorcado, trivia, sopa_de_letras, memotest)
  game        String   @default("tutti_frutti") @db.VarChar(30)
  max_players Int      @default(8)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  room_players room_players[]
  matches      matches[]
}

model room_players {
  id        String   @id @default(uuid()) @db.Uuid
  room_id   String   @db.Uuid
  user_id   String   @db.Uuid
  joined_at DateTime @default(now()) @db.Timestamp(6)

  room    rooms     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  user    users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  answers answers[]
  votes   votes[]

  @@unique([room_id, user_id])
}

// ============================================
// MATCHES & ROUNDS
// ============================================

model matches {
  id            String    @id @default(uuid()) @db.Uuid
  room_id       String?   @db.Uuid
  // Dueño de una partida solo (vs. IA); en multijugador los jugadores salen de room_players
  user_id       String?   @db.Uuid
  mode          String    @default("multiplayer") @db.VarChar(20)
  ai_difficulty String?   @db.VarChar(20)
  // Partida solo: temática elegida y duración de la ronda (para recalcular la IA en el servidor)
  tematica      String?   @db.VarChar(30)
  round_seconds Int?
  status        String    @default("in_progress") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  finished_at   DateTime?
  // Qué juego es (tutti_frutti, ahorcado, trivia, …: ver src/games/games.ts)
  game          String    @default("tutti_frutti") @db.VarChar(30)
  // Estado del juego que sólo conoce el servidor (palabra del ahorcado, respuestas de la trivia…).
  // NUNCA se manda entero al navegador.
  state         Json?

  room   rooms?   @relation(fields: [room_id], references: [id], onDelete: SetNull)
  user   users?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  rounds  rounds[]
  results match_results[]
  daily   daily_challenges?

  @@index([user_id])
  @@index([user_id, game, status])
}

// Pedidos de "¿Olvidaste tu contraseña?". Se guarda sólo el HASH del token (si alguien lee la
// base, no puede usar los links). Un solo uso y vencen a la hora.
model password_resets {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// Desafío del día (trivia diaria): una fila por usuario y día argentino ("AAAA-MM-DD").
// El índice único (user_id, day) garantiza que se juegue una sola vez por día.
model daily_challenges {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  day         String    @db.VarChar(10)
  match_id    String    @unique @db.Uuid
  completed   Boolean   @default(false)
  aciertos    Int       @default(0)
  puntos      Int       @default(0)
  ms_total    Int       @default(0)
  // Resultado para compartir sin spoilers: una letra por pregunta (V = bien, X = mal, T = sin tiempo)
  resultado   String    @default("") @db.VarChar(20)
  // Días seguidos jugados hasta este (incluido)
  racha       Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  finished_at DateTime?

  user  users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  match matches @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@unique([user_id, day])
  @@index([day, completed])
}

// Estadísticas de cada usuario en cada juego. Los totales generales siguen en profiles.
model game_stats {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  game           String   @db.VarChar(30)
  matches_played Int      @default(0)
  matches_won    Int      @default(0)
  total_points   Int      @default(0)
  best_score     Int      @default(0)
  current_streak Int      @default(0)
  best_streak    Int      @default(0)
  updated_at     DateTime @default(now()) @db.Timestamp(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, game])
  @@index([game, total_points])
}

model rounds {
  id           String    @id @default(uuid()) @db.Uuid
  match_id     String    @db.Uuid
  round_number Int
  letter       String    @db.VarChar(1)
  status       String    @default("answering") @db.VarChar(20)
  started_at   DateTime  @default(now()) @db.Timestamp(6)
  finished_at  DateTime?

  match   matches   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  answers answers[]

  @@unique([match_id, round_number])
}

// ============================================
// CATEGORIES
// ============================================

model categories {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  is_active   Boolean @default(true)
  is_advanced Boolean @default(false)
  season_id   String? @db.Uuid

  season  seasons?  @relation(fields: [season_id], references: [id], onDelete: SetNull)
  answers answers[]
}

// ============================================
// ANSWERS & VOTES
// ============================================

model answers {
  id             String   @id @default(uuid()) @db.Uuid
  round_id       String   @db.Uuid
  room_player_id String?  @db.Uuid
  category_id    String   @db.Uuid
  answer_text    String?  @db.VarChar(150)
  is_valid       Boolean?
  points         Int      @default(0)
  validated_by   String   @default("pending") @db.VarChar(20)

  round       rounds        @relation(fields: [round_id], references: [id], onDelete: Cascade)
  room_player room_players? @relation(fields: [room_player_id], references: [id], onDelete: Cascade)
  category    categories    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  votes       votes[]

  @@unique([round_id, room_player_id, category_id])
}

model votes {
  id             String  @id @default(uuid()) @db.Uuid
  answer_id      String  @db.Uuid
  room_player_id String  @db.Uuid
  user_id        String  @db.Uuid
  approve        Boolean

  answer      answers      @relation(fields: [answer_id], references: [id], onDelete: Cascade)
  room_player room_players @relation(fields: [room_player_id], references: [id], onDelete: Cascade)
  user        users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([answer_id, user_id])
}

// ============================================
// SEASONS
// ============================================

model seasons {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  is_active Boolean   @default(false)
  starts_at DateTime?
  ends_at   DateTime?

  categories categories[]
}
